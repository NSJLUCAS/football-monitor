{
  "name": "football-monitor",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "tsx dev/mock-server.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p upload-worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cover": "playwright test -c playwright.cover.config.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/verify-package.mjs",
    "licenses": "node scripts/licenses.mjs",
    "cards": "node scripts/cards.mjs",
    "carriers": "node scripts/carriers.mjs",
    "icons": "node scripts/icons.mjs",
    "portraits": "node scripts/portraits.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.6.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jose": "^6.2.13",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "ws": "^8.22.0"
  }
